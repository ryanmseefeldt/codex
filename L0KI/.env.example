# LOK|A| Multi-Model AI Intelligence Platform
# Environment Variables Configuration

# Claude AI API Key
# Get your key from: https://console.anthropic.com/
REACT_APP_CLAUDE_API_KEY=your-claude-api-key-here

# OpenAI API Key (for ChatGPT)
# Get your key from: https://platform.openai.com/api-keys
REACT_APP_OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini API Key
# Get your key from: https://makersuite.google.com/app/apikey
REACT_APP_GEMINI_API_KEY=your-gemini-api-key-here

# IMPORTANT SECURITY NOTES:
# 1. Never commit the actual .env file to version control
# 2. Add .env to your .gitignore file
# 3. For production, use a backend proxy to hide API keys
# 4. Each team member should have their own .env file with their own keys
